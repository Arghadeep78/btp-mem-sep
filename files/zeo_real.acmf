Model Zeo_real_1
// Created from model Zeo_real on Thursday, March 26, 2026


// Universal constants

// =======================
// PORTS
// =======================

Feed      as input  MoleFractionPort;
Permeate  as output MoleFractionPort;
Retentate as output MoleFractionPort;

// =======================
// VARIABLES
// =======================

// Feed component molar flows
nCH4_F as RealVariable;
nCO2_F as RealVariable;

// Permeate component molar flows
nCH4_P as RealVariable;
nCO2_P as RealVariable;

// Retentate component molar flows
nCH4_R as RealVariable;
nCO2_R as RealVariable;

nCH4_F = Feed.F * Feed.z("CH4");
nCO2_F = Feed.F * Feed.z("CO2");

// ===== SIMPLE PERMEATION (10% SPLIT) =====
nCH4_P = 0.1 * nCH4_F;
nCO2_P = 0.1 * nCO2_F;

// ===== RETENTATE =====
nCH4_R = nCH4_F - nCH4_P;
nCO2_R = nCO2_F - nCO2_P;

// ===== TOTAL FLOWS (AVOID ZERO) =====
Permeate.F = max(nCH4_P + nCO2_P, 1e-8);
Retentate.F = max(nCH4_R + nCO2_R, 1e-8);

// ===== NORMALIZED COMPOSITION =====
Permeate.z("CH4") = nCH4_P / Permeate.F;
Permeate.z("CO2") = nCO2_P / Permeate.F;

Retentate.z("CH4") = nCH4_R / Retentate.F;
Retentate.z("CO2") = nCO2_R / Retentate.F;

