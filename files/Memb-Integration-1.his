        843        DEFINE TYR MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        844            COMPONENT=TYROSINE UOM="kg/hr"
        845        DEFINE TRYP MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        846            COMPONENT=TRYPTOPH UOM="kg/hr"
        847        DEFINE PHE MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        848            COMPONENT=PHENYLAL UOM="kg/hr"
        849        DEFINE CYS MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        850            COMPONENT=CYSTEINE UOM="kg/hr"
        851        DEFINE MET MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        852            COMPONENT=METHIONI UOM="kg/hr"
        853        DEFINE THR MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        854            COMPONENT=THREONIN UOM="kg/hr"
        855        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        856            COMPONENT=H+ UOM="kg/hr"
        857        DEFINE KIN1 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        858            SENTENCE=RATE-CON ID1=1
        859        DEFINE KIN2 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        860            SENTENCE=RATE-CON ID1=2
        861        DEFINE KIN4 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        862            SENTENCE=RATE-CON ID1=4
        863        DEFINE KIN5 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        864            SENTENCE=RATE-CON ID1=5
        865        DEFINE KIN6 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        866            SENTENCE=RATE-CON ID1=6
        867        DEFINE KIN7 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        868            SENTENCE=RATE-CON ID1=7
        869        DEFINE KIN8 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        870            SENTENCE=RATE-CON ID1=8
        871        DEFINE KIN9 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        872            SENTENCE=RATE-CON ID1=9
        873        DEFINE KIN10 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        874            SENTENCE=RATE-CON ID1=10
        875        DEFINE KIN11 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        876            SENTENCE=RATE-CON ID1=11
        877        DEFINE KIN13 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        878            SENTENCE=RATE-CON ID1=13
        879        DEFINE KIN14 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        880            SENTENCE=RATE-CON ID1=14
        881        DEFINE KIN15 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        882            SENTENCE=RATE-CON ID1=16
        883        DEFINE KIN16 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        884            SENTENCE=RATE-CON ID1=15
        885        DEFINE KIN17 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        886            SENTENCE=RATE-CON ID1=17
        887        DEFINE KIN18 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        888            SENTENCE=RATE-CON ID1=18
        889        DEFINE KIN19 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        890            SENTENCE=RATE-CON ID1=19
        891        DEFINE KIN20 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        892            SENTENCE=RATE-CON ID1=20
        893        DEFINE KIN21 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        894            SENTENCE=RATE-CON ID1=21
        895        DEFINE KIN22 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        896            SENTENCE=RATE-CON ID1=22
        897        DEFINE KIN23 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        898            SENTENCE=RATE-CON ID1=23
        899    F      A = 0.0000001
        900    F      AA1 = ARG + LYS + TYR + TRYP + PHE + CYS + MET + THR + SER
        901    F      AA2 = LEU + ISO + VAL + GLU + ASP + GLY + ALA + PRO
        902    F      AA = AA1 + AA2
        903    F      IF (AA .EQ. 0.) THEN
        904    F       AA = AA + A
        905    F      ENDIF
        906    F      C_VOL = VOLFLOW
        907    F      IF (C_VOL .EQ. 0.) THEN
        908    F       C_VOL = C_VOL + A
        909    F      ENDIF
        910    F      C_PCONT = PCONT
        911    F      IF (C_PCONT .EQ. 0.) THEN
        912    F       C_PCONT = 0.0000001
        913    F      ENDIF
        914    F      PH = - ALOG10((C_PCONT) / (C_VOL))
        915    F      S = 0.0
        916    F      IF (PH .LT. 5.5) THEN
        917    F       S = ((PH - 5.5) / (5.5 - 4.0))
        918    F      ENDIF
        919    F      IF (S .LT. 0.0) THEN
        920    F       S = -S
        921    F      ENDIF
        922    F      R = ((-3.0) * (S**2.0))
        923    F      Q = (2.7182818284**(R))
        924    F      N = (1.0 / (1.0 + 0.3 / (AA / C_VOL)))
        925    F      TK = T + 273.15
        926    F      T0 = 55.0 + 273.15
        927    F      Z = 70.0 * EXP(-(-14143.72619 / 8.314) *
        928    F    &     (1.0 / TK - 1.0 / T0))
        929    F      L = (1.0 / (3600.0 * 24.0)) * Z
        930    F      K = L * N * Q
        931    F      KIN1 = K
        932    F      KIN2 = K
        933    F      KIN3 = K
        934    F      KIN4 = K
        935    F      KIN5 = K
        936    F      KIN6 = K
        937    F      KIN7 = K
        938    F      KIN8 = K
        939    F      KIN9 = K
        940    F      KIN10 = K
        941    F      KIN11 = K
        942    F      KIN12 = K
        943    F      KIN13 = K
        944    F      KIN14 = K
        945    F      KIN15 = K
        946    F      KIN16 = K
        947    F      KIN17 = K
        948    F      KIN18 = K
        949    F      KIN19 = K
        950    F      KIN20 = K
        951    F      KIN21 = K
        952    F      KIN22 = K
        953    F      KIN23 = K
        954        READ-VARS VOLFLOW T SER LEU ISO VAL ASP GLY GLU ALA  &
        955            PRO ARG LYS TYR TRYP PHE CYS MET THR PCONT
        956        WRITE-VARS KIN1 KIN2 KIN4 KIN5 KIN6 KIN7 KIN8 KIN9 KIN10  &
        957            KIN11 KIN13 KIN14 KIN15 KIN16 KIN17 KIN18 KIN19 KIN20  &
        958            KIN21 KIN22 KIN23
        959
        960    CALCULATOR BUTYDEG
        961        IN-UNITS SI SHORT-LENGTH=mm
        962    F      REAL BUTYFLOW, L, M, N, O, P, A
        963    F      REAL VOLFLOW, TNH3FLOW, HACFLOW, LCFAFLOW, KINETIC
        964    F      REAL PH, Q, PCONT, NH3, NH4, S, R
        965    F      REAL E, K, T, T0, U, H2, I, H2I, Z
        966        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
        967            VARIABLE=STDVOL-FLOW UOM="cum/hr"
        968        DEFINE HACFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        969            COMPONENT=ACETI-AC UOM="kg/hr"
        970        DEFINE NH3 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        971            COMPONENT=NH3 UOM="kg/hr"
        972        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        973            COMPONENT=OLEICACI UOM="kg/hr"
        974        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        975            COMPONENT=LINOLEIC UOM="kg/hr"
        976        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        977            COMPONENT=PALM UOM="kg/hr"
        978        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        979            COMPONENT=H+ UOM="kg/hr"
        980        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        981            COMPONENT=NH4+ UOM="kg/hr"
        982        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
        983            UOM="C"
        984        DEFINE H2 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        985            COMPONENT=HYDROGEN UOM="kg/hr"
        986        DEFINE BUTYFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        987            COMPONENT=ISOBU-01 UOM="kg/hr"
        988        DEFINE KINETIC REACT-VAR REACTION=ACETOGEN VARIABLE=PRE-EXP  &
        989            SENTENCE=RATE-CON ID1=3
        990    F      A = .00000001
        991    F      C_TNH3 = NH3 + NH4
        992    F
        993    F      C_HAC = HACFLOW
        994    F      IF (C_HAC .EQ. 0.) THEN
        995    F       C_HAC = C_HAC + A
        996    F      ENDIF
        997    F
        998    F      C_LCFA = LCFAFLOW + LINOFL + PALMFL
        999    F      IF (C_LCFA .EQ. 0.) THEN
       1000    F       C_LCFA = C_LCFA + A
       1001    F      ENDIF
       1002    F
       1003    F      C_VOL = VOLFLOW
       1004    F      IF (C_VOL .EQ. 0.) THEN
       1005    F       C_VOL = C_VOL + A
       1006    F      ENDIF
       1007    F
       1008    F      IF (C_TNH3 .EQ. 0.) THEN
       1009    F       C_TNH3 = C_TNH3 + A
       1010    F      ENDIF
       1011    F
       1012    F      C_PCONT = PCONT
       1013    F      IF (C_PCONT .EQ. 0.) THEN
       1014    F       C_PCONT = 0.0000001
       1015    F      ENDIF
       1016    F
       1017    F      C_BUTY = BUTYFLOW
       1018    F      IF (C_BUTY .EQ. 0.) THEN
       1019    F       C_BUTY = A
       1020    F      ENDIF
       1021    F
       1022    F      TK = T + 273.15
       1023    F      T0 = 55. + 273.15
       1024    F      H2I = 0.00003 + 0.000001 * ( TK - T0 )
       1025    F      I = ( 1. / ( 1. + ( H2 / C_VOL ) / H2I ) )
       1026    F      Z = 30. * EXP(-(-17043.8653 / 8.314) * (1. / TK - 1. / T0))
       1027    F      L = (1. / ( 3600. * 24. ) ) * Z
       1028    F      U = .176 + .01 * ( TK - T0 )
       1029    F      N = ( 1. / ( 1. + U / ( C_BUTY / C_VOL ) ) )
       1030    F      M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )
       1031    F      O = ( 1. / ( 1. + ( C_HAC / C_VOL ) / .72 ) )
       1032    F      P = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )
       1033    F
       1034    F      PH = - ALOG10((C_PCONT)/(C_VOL))
       1035    F      PH = 6.5
       1036    F      IF ( PH .LT. 5.5) THEN
       1037    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1038    F       IF (S .LT. 0.) THEN
       1039    F        S = -S
       1040    F       ENDIF
       1041    F       R = ((-3.) * (S**2.))
       1042    F       Q = (2.7182818284**(R))
       1043    F      ELSE
       1044    F       Q = 1.
       1045    F      ENDIF
       1046    F
       1047    F      K = L * N * M * O * P * Q * I
       1048    F      KINETIC = K
       1049        READ-VARS VOLFLOW HACFLOW NH3 LCFAFLOW PCONT NH4 T H2  &
       1050            BUTYFLOW LINOFL PALMFL
       1051        WRITE-VARS KINETIC
       1052
       1053    CALCULATOR DEXTDEG
       1054        IN-UNITS SI SHORT-LENGTH=mm
       1055    F      REAL VOLFLOW, GLUFLOW, TNH3FLOW, LCFAFLOW, KINETIC, L, N, M, O
       1056    F      REAL A, NH3, NH4, P
       1057    F      REAL E, K, T, T0, R, S, Q, PH, PCONT, Z
       1058        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
       1059            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1060        DEFINE GLUFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1061            COMPONENT=DEXTROSE UOM="kg/hr"
       1062        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1063            COMPONENT=OLEICACI UOM="kg/hr"
       1064        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1065            COMPONENT=LINOLEIC UOM="kg/hr"
       1066        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1067            COMPONENT=PALM UOM="kg/hr"
       1068        DEFINE NH3 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1069            COMPONENT=NH3 UOM="kg/hr"
       1070        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1071            COMPONENT=NH4+ UOM="kg/hr"
       1072        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1073            COMPONENT=H+ UOM="kg/hr"
       1074        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
       1075            UOM="C"
       1076        DEFINE KINETIC REACT-VAR REACTION=ACIDOGEN VARIABLE=PRE-EXP  &
       1077            SENTENCE=RATE-CON ID1=1
       1078    F      A = .00000001
       1079    F      C_TNH3 = NH3 + NH4
       1080
       1081    F      C_VOL = VOLFLOW
       1082    F      IF (C_VOL .EQ. 0.) THEN
       1083    F       C_VOL = C_VOL + A
       1084    F      ENDIF
       1085
       1086    F      C_LCFA = LCFAFLOW + LINOFL + PALMFL
       1087    F      IF (C_LCFA .EQ. 0.) THEN
       1088    F       C_LCFA = C_LCFA + A
       1089    F      ENDIF
       1090
       1091    F      IF (C_TNH3 .EQ. 0.) THEN
       1092    F       C_TNH3 = C_TNH3 + A
       1093    F      ENDIF
       1094
       1095    F      C_GLU = GLUFLOW
       1096    F      IF (C_GLU .EQ. 0.) THEN
       1097    F       C_GLU = C_GLU + A
       1098    F      ENDIF
       1099
       1100    F      TK = T + 273.15
       1101    F      T0 = 55. + 273.15
       1102
       1103    F      C_PCONT = PCONT
       1104    F      IF (C_PCONT .EQ. 0.) THEN
       1105    F       C_PCONT = 0.0000001
       1106    F      ENDIF
       1107
       1108    F      PH = - ALOG10((C_PCONT)/(C_VOL))
       1109    F      PH = 6.5
       1110    F      IF ( PH .LT. 5.5) THEN
       1111    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1112    F       IF (S .LT. 0.) THEN
       1113    F        S = -S
       1114    F       ENDIF
       1115    F       R = ((-3.)*(S**2.))
       1116    F       Q = (2.7182818284**(R))
       1117    F      ELSE
       1118    F       Q = 1.
       1119    F      ENDIF
       1120
       1121    F      Z = 70. * EXP(-(-35616.457 / 8.314) * (1. / TK - 1. / T0))
       1122    F      L = ( 1. / ( 3600. * 24. ) ) * Z
       1123    F      P = 0.5 + 0.025 * ( TK - T0 )
       1124    F      N = 5.1 * ( 1. / ( 1. + P / ( C_GLU / C_VOL ) ) )
       1125    F      M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )
       1126    F      O = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )
       1127    F      K = L * N * M * O * Q
       1128    F      KINETIC = K
       1129        READ-VARS VOLFLOW GLUFLOW LCFAFLOW NH3 NH4 PCONT T LINOFL  &
       1130            PALMFL
       1131        WRITE-VARS KINETIC
       1132
       1133    CALCULATOR GLYCDEG
       1134        IN-UNITS SI SHORT-LENGTH=mm
       1135    F      REAL VOLFLOW, GTOFLOW, TNH3FLOW, LCFAFLOW, KINETIC, L, N, M, O
       1136    F      REAL A, NH3, NH4
       1137    F      REAL PH, Q, PCONT, R, S
       1138        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
       1139            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1140        DEFINE GTOFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1141            COMPONENT=GLYCEROL UOM="kg/hr"
       1142        DEFINE NH3 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1143            COMPONENT=NH3 UOM="kg/hr"
       1144        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1145            COMPONENT=H+ UOM="kg/hr"
       1146        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1147            COMPONENT=NH4+ UOM="kg/hr"
       1148        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1149            COMPONENT=OLEICACI UOM="kg/hr"
       1150        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1151            COMPONENT=LINOLEIC UOM="kg/hr"
       1152        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1153            COMPONENT=PALM UOM="kg/hr"
       1154        DEFINE KINETIIC REACT-VAR REACTION=ACIDOGEN VARIABLE=PRE-EXP  &
       1155            SENTENCE=RATE-CON ID1=2
       1156    F      A = .00000001
       1157    F      C_TNH3 = NH3 + NH4
       1158
       1159    F      C_VOL = VOLFLOW
       1160    F      IF (C_VOL .EQ. 0.) THEN
       1161    F       C_VOL = C_VOL + A
       1162    F      ENDIF
       1163
       1164    F      C_LCFA = LCFAFLOW + LINOFL + PALMFL
       1165    F      IF (C_LCFA .EQ. 0.) THEN
       1166    F       C_LCFA = C_LCFA + A
       1167    F      ENDIF
       1168
       1169    F      IF (C_TNH3 .EQ. 0.) THEN
       1170    F       C_TNH3 = C_TNH3 + A
       1171    F      ENDIF
       1172
       1173    F      C_GTO = GTOFLOW
       1174    F      IF (C_GTO .EQ. 0.) THEN
