        835        DEFINE ALA MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        836            COMPONENT=ALANINE UOM="kg/hr"
        837        DEFINE PRO MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        838            COMPONENT=PROLINE UOM="kg/hr"
        839        DEFINE ARG MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
