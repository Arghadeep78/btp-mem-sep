        742
        743
        744    DEF-STREAMS MIXCISLD ALL
        745
        746    SOLVE
        747        PARAM METHOD=SM
        748        RUN-MODE MODE=SIM
        749
        750    FLOWSHEET
        751        BLOCK FLASH3 IN=RET OUT=PROD4 H2O-2
        752        BLOCK CH4PYRO IN=PYROIN OUT=FINPROD
        753        BLOCK PURGAS IN=GAS OUT=GAS2 WASTE
        754        BLOCK HEAT2 IN=PROD4 OUT=PYROIN
        755        BLOCK MEMB1 IN=GAS2C OUT=RET PER
        756        BLOCK COMP1 IN=GAS2 OUT=C1OUT
        757        BLOCK COOL1 IN=C1OUT OUT=K1OUT
        758        BLOCK COMP2 IN=K1OUT OUT=C2OUT
        759        BLOCK COOL2 IN=C2OUT OUT=GAS2C
        760
