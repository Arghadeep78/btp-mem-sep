       1605            COMPONENT=NH3 UOM="kg/hr"
       1606        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1607            COMPONENT=OLEICACI UOM="kg/hr"
       1608        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1609            COMPONENT=LINOLEIC UOM="kg/hr"
       1610        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1611            COMPONENT=PALM UOM="kg/hr"
       1612        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1613            COMPONENT=H+ UOM="kg/hr"
       1614        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1615            COMPONENT=NH4+ UOM="kg/hr"
       1616        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
       1617            UOM="C"
       1618        DEFINE H2 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1619            COMPONENT=HYDROGEN UOM="kg/hr"
       1620        DEFINE KINETIC REACT-VAR REACTION=ACETOGEN VARIABLE=PRE-EXP  &
       1621            SENTENCE=RATE-CON ID1=4
       1622        DEFINE VALEFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1623            COMPONENT=ISOVA-01 UOM="kg/hr"
       1624    F     A = .00000001
       1625
       1626    F     CHAC = HACFLOW
       1627    F     IF (CHAC .EQ. 0.) THEN
       1628    F       CHAC = A
       1629    F     ENDIF
       1630
       1631    F     CLCFA = LCFAFLOW + LINOFL + PALMFL
       1632    F     IF (CLCFA .EQ. 0.) THEN
       1633    F       CLCFA = A
       1634    F     ENDIF
       1635
       1636    F     CVOL = VOLFLOW
       1637    F     IF (CVOL .EQ. 0.) THEN
       1638    F       CVOL = A
       1639    F     ENDIF
       1640
       1641    F     CTNH3 = TNH3FLOW + NH4
       1642    F     IF (CTNH3 .EQ. 0.) THEN
       1643    F       CTNH3 = A
       1644    F     ENDIF
       1645
       1646    F     CPCONT = PCONT
       1647    F     IF (CPCONT .EQ. 0.) THEN
       1648    F       CPCONT = 0.0000001
       1649    F     ENDIF
       1650
       1651    F     CVALE = VALEFLOW
       1652    F     IF (CVALE .EQ. 0.) THEN
       1653    F       CVALE = A
       1654    F     ENDIF
       1655
       1656    F     TK = T + 273.15
       1657    F     T0 = 55. + 273.15
       1658
       1659    F     H2I = 0.00003 + 0.000001 * ( TK - T0 )
       1660    F     I = 1. / ( 1. + ( H2 / CVOL ) / H2I )
       1661    F
       1662    F     Z1 = -17043.8653 / 8.314
       1663    F     Z2 = 1. / TK - 1. / T0
       1664    F     Z = 30. * EXP(-(Z1) * Z2)
       1665    F
       1666    F     L = (1. / ( 3600. * 24. ) ) * Z
       1667    F     U = .175 + .01 * ( TK - T0 )
       1668    F     N = 1. / ( 1. + U / ( CVALE / CVOL ) )
       1669    F     M = 1. / ( 1. + .05 / ( CTNH3 / CVOL ) )
       1670    F     O = 1. / ( 1. + ( CHAC / CVOL ) / .4 )
       1671    F     P = 1. / ( 1. + ( CLCFA / CVOL ) / 5. )
       1672
       1673    F     PH = - ALOG10((CPCONT) / CVOL)
       1674    F     PH = 6.5
       1675    F     IF ( PH .LT. 5.5) THEN
       1676    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1677    F       IF (S .LT. 0.) THEN
       1678    F         S = -S
       1679    F       ENDIF
       1680    F       R = (-3.) * (S**2.)
       1681    F       Q = 2.7182818284**(R)
       1682    F     ELSE
       1683    F       Q = 1.
       1684    F     ENDIF
       1685
       1686    F     K = L * N * M * O * P * Q * I
       1687    F     KINETIC = K
       1688        READ-VARS VOLFLOW HACFLOW TNH3FLOW LCFAFLOW PCONT NH4 T  &
       1689            H2 VALEFLOW LINOFL PALMFL
       1690        WRITE-VARS KINETIC
