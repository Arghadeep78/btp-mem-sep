       1059    CALCULATOR DEXTDEG
       1060        IN-UNITS SI SHORT-LENGTH=mm
       1061    F      REAL VOLFLOW, GLUFLOW, TNH3FLOW, LCFAFLOW, KINETIC, L, N, M, O
       1062    F      REAL A, NH3, NH4, P
       1063    F      REAL E, K, T, T0, R, S, Q, PH, PCONT, Z
       1064        DEFINE VOLFLOW STREAM-VAR STREAM=5 SUBSTREAM=MIXED  &
       1065            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1066        DEFINE GLUFLOW MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1067            COMPONENT=DEXTROSE UOM="kg/hr"
       1068        DEFINE LCFAFLOW MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1069            COMPONENT=OLEICACI UOM="kg/hr"
       1070        DEFINE NH3 MASS-FLOW STREAM=5 SUBSTREAM=MIXED COMPONENT=NH3  &
       1071            UOM="kg/hr"
       1072        DEFINE NH4 MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1073            COMPONENT=NH4+ UOM="kg/hr"
       1074        DEFINE PCONT MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1075            COMPONENT=H+ UOM="kg/hr"
       1076        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
       1077            UOM="C"
       1078        DEFINE KINETIC REACT-VAR REACTION=ACIDOGEN VARIABLE=PRE-EXP  &
       1079            SENTENCE=RATE-CON ID1=1
       1080    F      A = .00000001
       1081    F      C_TNH3 = NH3 + NH4
       1082
       1083    F      C_VOL = VOLFLOW
       1084    F      IF (C_VOL .EQ. 0.) THEN
       1085    F       C_VOL = C_VOL + A
       1086    F      ENDIF
       1087
       1088    F      C_LCFA = LCFAFLOW
       1089    F      IF (C_LCFA .EQ. 0.) THEN
       1090    F       C_LCFA = C_LCFA + A
       1091    F      ENDIF
       1092
       1093    F      IF (C_TNH3 .EQ. 0.) THEN
       1094    F       C_TNH3 = C_TNH3 + A
       1095    F      ENDIF
       1096
       1097    F      C_GLU = GLUFLOW
       1098    F      IF (C_GLU .EQ. 0.) THEN
       1099    F       C_GLU = C_GLU + A
       1100    F      ENDIF
       1101
       1102    F      TK = T + 273.15
       1103    F      T0 = 55. + 273.15
       1104
       1105    F      C_PCONT = PCONT
       1106    F      IF (C_PCONT .EQ. 0.) THEN
       1107    F       C_PCONT = 0.0000001
       1108    F      ENDIF
       1109
       1110    F      PH = - ALOG10((C_PCONT)/(C_VOL))
       1111    F      PH = 6.5
       1112    F      IF ( PH .LT. 5.5) THEN
       1113    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1114    F       IF (S .LT. 0.) THEN
       1115    F        S = -S
       1116    F       ENDIF
       1117    F       R = ((-3.)*(S**2.))
       1118    F       Q = (2.7182818284**(R))
       1119    F      ELSE
       1120    F       Q = 1.
       1121    F      ENDIF
       1122
       1123    F      Z = 70. * EXP(-(-35616.457 / 8.314) * (1. / TK - 1. / T0))
       1124    F      L = ( 1. / ( 3600. * 24. ) ) * Z
       1125    F      P = 0.5 + 0.025 * ( TK - T0 )
       1126    F      N = 5.1 * ( 1. / ( 1. + P / ( C_GLU / C_VOL ) ) )
       1127    F      M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )
       1128    F      O = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )
       1129    F      K = L * N * M * O * Q
       1130    F      KINETIC = K
       1131        READ-VARS VOLFLOW GLUFLOW LCFAFLOW NH3 NH4 PCONT T
       1132        WRITE-VARS KINETIC
       1133        EXECUTE BEFORE BLOCK B1
