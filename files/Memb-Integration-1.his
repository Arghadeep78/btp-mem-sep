        875        DEFINE KIN7 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        876            SENTENCE=RATE-CON ID1=7
        877        DEFINE KIN8 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        878            SENTENCE=RATE-CON ID1=8
        879        DEFINE KIN9 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        880            SENTENCE=RATE-CON ID1=9
        881        DEFINE KIN10 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        882            SENTENCE=RATE-CON ID1=10
        883        DEFINE KIN11 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        884            SENTENCE=RATE-CON ID1=11
        885        DEFINE KIN13 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        886            SENTENCE=RATE-CON ID1=13
        887        DEFINE KIN14 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        888            SENTENCE=RATE-CON ID1=14
        889        DEFINE KIN15 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        890            SENTENCE=RATE-CON ID1=16
        891        DEFINE KIN16 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        892            SENTENCE=RATE-CON ID1=15
        893        DEFINE KIN17 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        894            SENTENCE=RATE-CON ID1=17
        895        DEFINE KIN18 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        896            SENTENCE=RATE-CON ID1=18
        897        DEFINE KIN19 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        898            SENTENCE=RATE-CON ID1=19
        899        DEFINE KIN20 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        900            SENTENCE=RATE-CON ID1=20
        901        DEFINE KIN21 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        902            SENTENCE=RATE-CON ID1=21
        903        DEFINE KIN22 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        904            SENTENCE=RATE-CON ID1=22
