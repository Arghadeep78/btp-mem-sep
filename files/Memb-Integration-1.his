        808    CALCULATOR AMINODEG
        809        IN-UNITS SI SHORT-LENGTH=mm
        810    F      REAL KIN1, KIN2, KIN3, KIN4, KIN5, KIN6, KIN7, KIN8, KIN9
        811    F      REAL KIN10, KIN11, KIN12, KIN13, KIN14, KIN15, KIN16, KIN17
        812    F      REAL KIN18, KIN19, KIN20, KIN21, KIN22, KIN23, K, L, TO, N
        813    F      REAL VOLFLOW, PCONT
        814    F      REAL  ARG, HIS, LYS, TYR, TRYP, PHE, CYS, MET, THR, SER
        815    F      REAL  LEU, ISO, VAL, GLU, ASP, GLY, ALA, PRO
        816    F      REAL  AA, AA1, AA2, A, Q, R, PH, S, Z
        817        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
        818            VARIABLE=STDVOL-FLOW UOM="cum/hr"
        819        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
        820            UOM="C"
        821        DEFINE SER MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        822            COMPONENT=SERINE UOM="kg/hr"
        823        DEFINE LEU MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        824            COMPONENT=LEUCINE UOM="kg/hr"
        825        DEFINE ISO MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        826            COMPONENT=ISOLEUCI UOM="kg/hr"
        827        DEFINE VAL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        828            COMPONENT=VALINE UOM="kg/hr"
        829        DEFINE ASP MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        830            COMPONENT=ASPARTIC UOM="kg/hr"
        831        DEFINE GLY MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        832            COMPONENT=GLYCINE UOM="kg/hr"
        833        DEFINE GLU MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
