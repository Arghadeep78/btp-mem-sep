       1627    F     CTNH3 = TNH3FLOW
       1628    F     IF (CTNH3 .EQ. 0.) THEN
       1629    F       CTNH3 = A
       1630    F     ENDIF
       1631
       1632    F     CPCONT = PCONT
       1633    F     IF (CPCONT .EQ. 0.) THEN
       1634    F       CPCONT = 0.0000001
       1635    F     ENDIF
       1636
       1637    F     CVALE = VALEFLOW
       1638    F     IF (CVALE .EQ. 0.) THEN
       1639    F       CVALE = A
       1640    F     ENDIF
       1641
       1642    F     TK = T + 273.15
       1643    F     T0 = 55. + 273.15
       1644
       1645    F     H2I = 0.00003 + 0.000001 * ( TK - T0 )
       1646    F     I = 1. / ( 1. + ( H2 / CVOL ) / H2I )
       1647    F
       1648    F     Z1 = -17043.8653 / 8.314
       1649    F     Z2 = 1. / TK - 1. / T0
       1650    F     Z = 30. * EXP(-(Z1) * Z2)
       1651    F
       1652    F     L = (1. / ( 3600. * 24. ) ) * Z
       1653    F     U = .175 + .01 * ( TK - T0 )
       1654    F     N = 1. / ( 1. + U / ( CVALE / CVOL ) )
       1655    F     M = 1. / ( 1. + .05 / ( CTNH3 / CVOL ) )
       1656    F     O = 1. / ( 1. + ( CHAC / CVOL ) / .4 )
       1657    F     P = 1. / ( 1. + ( CLCFA / CVOL ) / 5. )
       1658
       1659    F     PH = - ALOG10((CPCONT) / CVOL)
       1660    F     PH = 6.5
       1661    F     IF ( PH .LT. 5.5) THEN
       1662    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1663    F       IF (S .LT. 0.) THEN
       1664    F         S = -S
       1665    F       ENDIF
       1666    F       R = (-3.) * (S**2.)
       1667    F       Q = 2.7182818284**(R)
       1668    F     ELSE
       1669    F       Q = 1.
       1670    F     ENDIF
       1671
       1672    F     K = L * N * M * O * P * Q * I
       1673    F     KINETIC = K
