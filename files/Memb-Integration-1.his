        969    CALCULATOR BUTYDEG
        970        IN-UNITS SI SHORT-LENGTH=mm
        971    F      REAL BUTYFLOW, L, M, N, O, P, A
        972    F      REAL VOLFLOW, TNH3FLOW, HACFLOW, LCFAFLOW, KINETIC
        973    F      REAL PH, Q, PCONT, NH3, NH4, S, R
        974    F      REAL E, K, T, T0, U, H2, I, H2I, Z
        975        DEFINE VOLFLOW STREAM-VAR STREAM=5 SUBSTREAM=MIXED  &
        976            VARIABLE=STDVOL-FLOW UOM="cum/hr"
        977        DEFINE HACFLOW MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
        978            COMPONENT=ACETI-AC UOM="kg/hr"
        979        DEFINE NH3 MASS-FLOW STREAM=5 SUBSTREAM=MIXED COMPONENT=NH3  &
        980            UOM="kg/hr"
        981        DEFINE LCFAFLOW MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
        982            COMPONENT=OLEICACI UOM="kg/hr"
        983        DEFINE PCONT MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
        984            COMPONENT=H+ UOM="kg/hr"
        985        DEFINE NH4 MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
        986            COMPONENT=NH4+ UOM="kg/hr"
        987        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
        988            UOM="C"
        989        DEFINE H2 MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
        990            COMPONENT=HYDROGEN UOM="kg/hr"
        991        DEFINE BUTYFLOW MASS-FRAC STREAM=5 SUBSTREAM=MIXED  &
        992            COMPONENT=ISOBU-01
        993        DEFINE KINETIC REACT-VAR REACTION=ACETOGEN VARIABLE=PRE-EXP  &
        994            SENTENCE=RATE-CON ID1=3
        995    F      A = .00000001
        996    F      C_TNH3 = NH3 + NH4
        997    F
        998    F      C_HAC = HACFLOW
        999    F      IF (C_HAC .EQ. 0.) THEN
       1000    F       C_HAC = C_HAC + A
       1001    F      ENDIF
       1002    F
       1003    F      C_LCFA = LCFAFLOW
       1004    F      IF (C_LCFA .EQ. 0.) THEN
       1005    F       C_LCFA = C_LCFA + A
       1006    F      ENDIF
       1007    F
       1008    F      C_VOL = VOLFLOW
       1009    F      IF (C_VOL .EQ. 0.) THEN
       1010    F       C_VOL = C_VOL + A
       1011    F      ENDIF
       1012    F
       1013    F      IF (C_TNH3 .EQ. 0.) THEN
       1014    F       C_TNH3 = C_TNH3 + A
       1015    F      ENDIF
       1016    F
       1017    F      C_PCONT = PCONT
       1018    F      IF (C_PCONT .EQ. 0.) THEN
       1019    F       C_PCONT = 0.0000001
       1020    F      ENDIF
       1021    F
       1022    F      C_BUTY = BUTYFLOW
       1023    F      IF (C_BUTY .EQ. 0.) THEN
       1024    F       C_BUTY = A
       1025    F      ENDIF
       1026    F
       1027    F      TK = T + 273.15
       1028    F      T0 = 55. + 273.15
       1029    F      H2I = 0.00003 + 0.000001 * ( TK - T0 )
       1030    F      I = ( 1. / ( 1. + ( H2 / C_VOL ) / H2I ) )
       1031    F      Z = 30. * EXP(-(-17043.8653 / 8.314) * (1. / TK - 1. / T0))
       1032    F      L = (1. / ( 3600. * 24. ) ) * Z
       1033    F      U = .176 + .01 * ( TK - T0 )
       1034    F      N = ( 1. / ( 1. + U / ( C_BUTY / C_VOL ) ) )
       1035    F      M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )
       1036    F      O = ( 1. / ( 1. + ( C_HAC / C_VOL ) / .72 ) )
       1037    F      P = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )
       1038    F
       1039    F      PH = - ALOG10((C_PCONT)/(C_VOL))
       1040    F      PH = 6.5
       1041    F      IF ( PH .LT. 5.5) THEN
       1042    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1043    F       IF (S .LT. 0.) THEN
       1044    F        S = -S
       1045    F       ENDIF
       1046    F       R = ((-3.) * (S**2.))
       1047    F       Q = (2.7182818284**(R))
       1048    F      ELSE
       1049    F       Q = 1.
       1050    F      ENDIF
       1051    F
       1052    F      K = L * N * M * O * P * Q * I
       1053    F      KINETIC = K
       1054        READ-VARS VOLFLOW HACFLOW NH3 LCFAFLOW PCONT NH4 T H2  &
       1055            BUTYFLOW
       1056        WRITE-VARS KINETIC
       1057        EXECUTE BEFORE BLOCK B1
