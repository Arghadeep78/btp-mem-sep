       1614    CALCULATOR VALEDEG
       1615        IN-UNITS SI SHORT-LENGTH=mm
       1616    F      REAL VALEFLOW, L, M, N, O, P, A
       1617    F      REAL VOLFLOW, TNH3FLOW, HACFLOW, LCFAFLOW, KINETIC
       1618    F      REAL PH, Q, PCONT, NH3, NH4
       1619    F      REAL E, K, T, T0, U, H2, I, H2I, Z
       1620        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
       1621            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1622        DEFINE HACFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1623            COMPONENT=ACETI-AC UOM="kg/hr"
       1624        DEFINE TNH3FLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1625            COMPONENT=NH3 UOM="kg/hr"
       1626        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1627            COMPONENT=OLEICACI UOM="kg/hr"
       1628        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1629            COMPONENT=LINOLEIC UOM="kg/hr"
       1630        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1631            COMPONENT=PALM UOM="kg/hr"
       1632        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1633            COMPONENT=H+ UOM="kg/hr"
       1634        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1635            COMPONENT=NH4+ UOM="kg/hr"
       1636        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
       1637            UOM="C"
       1638        DEFINE H2 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1639            COMPONENT=HYDROGEN UOM="kg/hr"
       1640        DEFINE KINETIC REACT-VAR REACTION=ACETOGEN VARIABLE=PRE-EXP  &
       1641            SENTENCE=RATE-CON ID1=4
       1642        DEFINE VALEFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1643            COMPONENT=ISOVA-01 UOM="kg/hr"
       1644    F     A = .00000001
       1645
       1646    F     CHAC = HACFLOW
       1647    F     IF (CHAC .EQ. 0.) THEN
       1648    F       CHAC = A
       1649    F     ENDIF
       1650
       1651    F     CLCFA = LCFAFLOW + LINOFL + PALMFL
       1652    F     IF (CLCFA .EQ. 0.) THEN
       1653    F       CLCFA = A
       1654    F     ENDIF
       1655
       1656    F     CVOL = VOLFLOW
       1657    F     IF (CVOL .EQ. 0.) THEN
       1658    F       CVOL = A
       1659    F     ENDIF
       1660
       1661    F     CTNH3 = TNH3FLOW + NH4
       1662    F     IF (CTNH3 .EQ. 0.) THEN
       1663    F       CTNH3 = A
       1664    F     ENDIF
       1665
       1666    F     CPCONT = PCONT
       1667    F     IF (CPCONT .EQ. 0.) THEN
       1668    F       CPCONT = 0.0000001
       1669    F     ENDIF
       1670
       1671    F     CVALE = VALEFLOW
       1672    F     IF (CVALE .EQ. 0.) THEN
       1673    F       CVALE = A
       1674    F     ENDIF
       1675
       1676    F     TK = T + 273.15
       1677    F     T0 = 55. + 273.15
       1678
       1679    F     H2I = 0.00003 + 0.000001 * ( TK - T0 )
       1680    F     I = 1. / ( 1. + ( H2 / CVOL ) / H2I )
       1681    F
       1682    F     Z1 = -17043.8653 / 8.314
       1683    F     Z2 = 1. / TK - 1. / T0
       1684    F     Z = 30. * EXP(-(Z1) * Z2)
       1685    F
       1686    F     L = (1. / ( 3600. * 24. ) ) * Z
       1687    F     U = .175 + .01 * ( TK - T0 )
       1688    F     N = 1. / ( 1. + U / ( CVALE / CVOL ) )
       1689    F     M = 1. / ( 1. + .05 / ( CTNH3 / CVOL ) )
       1690    F     O = 1. / ( 1. + ( CHAC / CVOL ) / .4 )
       1691    F     P = 1. / ( 1. + ( CLCFA / CVOL ) / 5. )
       1692
       1693    F     PH = - ALOG10((CPCONT) / CVOL)
       1694    F     PH = 6.5
       1695    F     IF ( PH .LT. 5.5) THEN
       1696    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1697    F       IF (S .LT. 0.) THEN
       1698    F         S = -S
       1699    F       ENDIF
       1700    F       R = (-3.) * (S**2.)
       1701    F       Q = 2.7182818284**(R)
       1702    F     ELSE
       1703    F       Q = 1.
       1704    F     ENDIF
       1705
       1706    F     K = L * N * M * O * P * Q * I
       1707    F     KINETIC = K
       1708        READ-VARS VOLFLOW HACFLOW TNH3FLOW LCFAFLOW PCONT NH4 T  &
       1709            H2 VALEFLOW LINOFL PALMFL
