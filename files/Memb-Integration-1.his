        830    EO-CONV-OPTI
        831
        832    CALCULATOR AMINODEG
        833        IN-UNITS SI SHORT-LENGTH=mm
        834    F      REAL KIN1, KIN2, KIN3, KIN4, KIN5, KIN6, KIN7, KIN8, KIN9
        835    F      REAL KIN10, KIN11, KIN12, KIN13, KIN14, KIN15, KIN16, KIN17
        836    F      REAL KIN18, KIN19, KIN20, KIN21, KIN22, KIN23, K, L, TO, N
        837    F      REAL VOLFLOW, PCONT
        838    F      REAL  ARG, HIS, LYS, TYR, TRYP, PHE, CYS, MET, THR, SER
        839    F      REAL  LEU, ISO, VAL, GLU, ASP, GLY, ALA, PRO
        840    F      REAL  AA, AA1, AA2, A, Q, R, PH, S, Z
        841        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
        842            VARIABLE=STDVOL-FLOW UOM="cum/hr"
        843        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
        844            UOM="C"
        845        DEFINE SER MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        846            COMPONENT=SERINE UOM="kg/hr"
        847        DEFINE LEU MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        848            COMPONENT=LEUCINE UOM="kg/hr"
        849        DEFINE ISO MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        850            COMPONENT=ISOLEUCI UOM="kg/hr"
        851        DEFINE VAL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        852            COMPONENT=VALINE UOM="kg/hr"
        853        DEFINE ASP MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        854            COMPONENT=ASPARTIC UOM="kg/hr"
        855        DEFINE GLY MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        856            COMPONENT=GLYCINE UOM="kg/hr"
        857        DEFINE GLU MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        858            COMPONENT=GLUTAMIC UOM="kg/hr"
        859        DEFINE ALA MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        860            COMPONENT=ALANINE UOM="kg/hr"
        861        DEFINE PRO MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        862            COMPONENT=PROLINE UOM="kg/hr"
        863        DEFINE ARG MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        864            COMPONENT=ARGININE UOM="kg/hr"
        865        DEFINE LYS MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        866            COMPONENT=LYSINE UOM="kg/hr"
        867        DEFINE TYR MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        868            COMPONENT=TYROSINE UOM="kg/hr"
        869        DEFINE TRYP MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        870            COMPONENT=TRYPTOPH UOM="kg/hr"
        871        DEFINE PHE MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        872            COMPONENT=PHENYLAL UOM="kg/hr"
        873        DEFINE CYS MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        874            COMPONENT=CYSTEINE UOM="kg/hr"
        875        DEFINE MET MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        876            COMPONENT=METHIONI UOM="kg/hr"
        877        DEFINE THR MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        878            COMPONENT=THREONIN UOM="kg/hr"
        879        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        880            COMPONENT=H+ UOM="kg/hr"
        881        DEFINE KIN1 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        882            SENTENCE=RATE-CON ID1=1
        883        DEFINE KIN2 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        884            SENTENCE=RATE-CON ID1=2
        885        DEFINE KIN4 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        886            SENTENCE=RATE-CON ID1=4
        887        DEFINE KIN5 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        888            SENTENCE=RATE-CON ID1=5
        889        DEFINE KIN6 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        890            SENTENCE=RATE-CON ID1=6
        891        DEFINE KIN7 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        892            SENTENCE=RATE-CON ID1=7
        893        DEFINE KIN8 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        894            SENTENCE=RATE-CON ID1=8
        895        DEFINE KIN9 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        896            SENTENCE=RATE-CON ID1=9
        897        DEFINE KIN10 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        898            SENTENCE=RATE-CON ID1=10
        899        DEFINE KIN11 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        900            SENTENCE=RATE-CON ID1=11
        901        DEFINE KIN13 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        902            SENTENCE=RATE-CON ID1=13
        903        DEFINE KIN14 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        904            SENTENCE=RATE-CON ID1=14
        905        DEFINE KIN15 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        906            SENTENCE=RATE-CON ID1=16
        907        DEFINE KIN16 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        908            SENTENCE=RATE-CON ID1=15
        909        DEFINE KIN17 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        910            SENTENCE=RATE-CON ID1=17
        911        DEFINE KIN18 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        912            SENTENCE=RATE-CON ID1=18
        913        DEFINE KIN19 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        914            SENTENCE=RATE-CON ID1=19
        915        DEFINE KIN20 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        916            SENTENCE=RATE-CON ID1=20
        917        DEFINE KIN21 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        918            SENTENCE=RATE-CON ID1=21
        919        DEFINE KIN22 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        920            SENTENCE=RATE-CON ID1=22
        921        DEFINE KIN23 REACT-VAR REACTION=AMINOACI VARIABLE=PRE-EXP  &
        922            SENTENCE=RATE-CON ID1=23
        923    F      A = 0.0000001
        924    F      AA1 = ARG + LYS + TYR + TRYP + PHE + CYS + MET + THR + SER
        925    F      AA2 = LEU + ISO + VAL + GLU + ASP + GLY + ALA + PRO
        926    F      AA = AA1 + AA2
        927    F      IF (AA .EQ. 0.) THEN
        928    F       AA = AA + A
        929    F      ENDIF
        930    F      C_VOL = VOLFLOW
        931    F      IF (C_VOL .EQ. 0.) THEN
        932    F       C_VOL = C_VOL + A
        933    F      ENDIF
        934    F      C_PCONT = PCONT
        935    F      IF (C_PCONT .EQ. 0.) THEN
        936    F       C_PCONT = 0.0000001
        937    F      ENDIF
        938    F      PH = - ALOG10((C_PCONT) / (C_VOL))
        939    F      S = 0.0
        940    F      IF (PH .LT. 5.5) THEN
        941    F       S = ((PH - 5.5) / (5.5 - 4.0))
        942    F      ENDIF
        943    F      IF (S .LT. 0.0) THEN
        944    F       S = -S
        945    F      ENDIF
        946    F      R = ((-3.0) * (S**2.0))
        947    F      Q = (2.7182818284**(R))
        948    F      N = (1.0 / (1.0 + 0.3 / (AA / C_VOL)))
        949    F      TK = T + 273.15
        950    F      T0 = 55.0 + 273.15
        951    F      Z = 70.0 * EXP(-(-14143.72619 / 8.314) *
        952    F    &     (1.0 / TK - 1.0 / T0))
        953    F      L = (1.0 / (3600.0 * 24.0)) * Z
        954    F      K = L * N * Q
        955    F      KIN1 = K
        956    F      KIN2 = K
        957    F      KIN3 = K
        958    F      KIN4 = K
        959    F      KIN5 = K
        960    F      KIN6 = K
        961    F      KIN7 = K
        962    F      KIN8 = K
        963    F      KIN9 = K
        964    F      KIN10 = K
        965    F      KIN11 = K
        966    F      KIN12 = K
        967    F      KIN13 = K
        968    F      KIN14 = K
        969    F      KIN15 = K
        970    F      KIN16 = K
        971    F      KIN17 = K
        972    F      KIN18 = K
        973    F      KIN19 = K
        974    F      KIN20 = K
        975    F      KIN21 = K
        976    F      KIN22 = K
        977    F      KIN23 = K
        978        READ-VARS VOLFLOW T SER LEU ISO VAL ASP GLY GLU ALA  &
        979            PRO ARG LYS TYR TRYP PHE CYS MET THR PCONT
        980        WRITE-VARS KIN1 KIN2 KIN4 KIN5 KIN6 KIN7 KIN8 KIN9 KIN10  &
        981            KIN11 KIN13 KIN14 KIN15 KIN16 KIN17 KIN18 KIN19 KIN20  &
        982            KIN21 KIN22 KIN23
        983
        984    CALCULATOR BUTYDEG
        985        IN-UNITS SI SHORT-LENGTH=mm
        986    F      REAL BUTYFLOW, L, M, N, O, P, A
        987    F      REAL VOLFLOW, TNH3FLOW, HACFLOW, LCFAFLOW, KINETIC
        988    F      REAL PH, Q, PCONT, NH3, NH4, S, R
        989    F      REAL E, K, T, T0, U, H2, I, H2I, Z
        990        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
        991            VARIABLE=STDVOL-FLOW UOM="cum/hr"
        992        DEFINE HACFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        993            COMPONENT=ACETI-AC UOM="kg/hr"
        994        DEFINE NH3 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        995            COMPONENT=NH3 UOM="kg/hr"
        996        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        997            COMPONENT=OLEICACI UOM="kg/hr"
        998        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
        999            COMPONENT=LINOLEIC UOM="kg/hr"
       1000        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1001            COMPONENT=PALM UOM="kg/hr"
       1002        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1003            COMPONENT=H+ UOM="kg/hr"
       1004        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1005            COMPONENT=NH4+ UOM="kg/hr"
       1006        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
       1007            UOM="C"
       1008        DEFINE H2 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1009            COMPONENT=HYDROGEN UOM="kg/hr"
       1010        DEFINE BUTYFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1011            COMPONENT=ISOBU-01 UOM="kg/hr"
       1012        DEFINE KINETIC REACT-VAR REACTION=ACETOGEN VARIABLE=PRE-EXP  &
       1013            SENTENCE=RATE-CON ID1=3
       1014    F      A = .00000001
       1015    F      C_TNH3 = NH3 + NH4
       1016    F
       1017    F      C_HAC = HACFLOW
       1018    F      IF (C_HAC .EQ. 0.) THEN
       1019    F       C_HAC = C_HAC + A
       1020    F      ENDIF
       1021    F
       1022    F      C_LCFA = LCFAFLOW + LINOFL + PALMFL
       1023    F      IF (C_LCFA .EQ. 0.) THEN
       1024    F       C_LCFA = C_LCFA + A
       1025    F      ENDIF
       1026    F
       1027    F      C_VOL = VOLFLOW
       1028    F      IF (C_VOL .EQ. 0.) THEN
       1029    F       C_VOL = C_VOL + A
       1030    F      ENDIF
       1031    F
       1032    F      IF (C_TNH3 .EQ. 0.) THEN
       1033    F       C_TNH3 = C_TNH3 + A
       1034    F      ENDIF
       1035    F
       1036    F      C_PCONT = PCONT
       1037    F      IF (C_PCONT .EQ. 0.) THEN
       1038    F       C_PCONT = 0.0000001
       1039    F      ENDIF
       1040    F
       1041    F      C_BUTY = BUTYFLOW
       1042    F      IF (C_BUTY .EQ. 0.) THEN
       1043    F       C_BUTY = A
       1044    F      ENDIF
       1045    F
       1046    F      TK = T + 273.15
       1047    F      T0 = 55. + 273.15
       1048    F      H2I = 0.00003 + 0.000001 * ( TK - T0 )
       1049    F      I = ( 1. / ( 1. + ( H2 / C_VOL ) / H2I ) )
       1050    F      Z = 30. * EXP(-(-17043.8653 / 8.314) * (1. / TK - 1. / T0))
       1051    F      L = (1. / ( 3600. * 24. ) ) * Z
       1052    F      U = .176 + .01 * ( TK - T0 )
       1053    F      N = ( 1. / ( 1. + U / ( C_BUTY / C_VOL ) ) )
       1054    F      M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )
       1055    F      O = ( 1. / ( 1. + ( C_HAC / C_VOL ) / .72 ) )
       1056    F      P = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )
       1057    F
       1058    F      PH = - ALOG10((C_PCONT)/(C_VOL))
       1059    F      PH = 6.5
       1060    F      IF ( PH .LT. 5.5) THEN
       1061    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1062    F       IF (S .LT. 0.) THEN
       1063    F        S = -S
       1064    F       ENDIF
       1065    F       R = ((-3.) * (S**2.))
       1066    F       Q = (2.7182818284**(R))
       1067    F      ELSE
       1068    F       Q = 1.
       1069    F      ENDIF
       1070    F
       1071    F      K = L * N * M * O * P * Q * I
       1072    F      KINETIC = K
       1073        READ-VARS VOLFLOW HACFLOW NH3 LCFAFLOW PCONT NH4 T H2  &
       1074            BUTYFLOW LINOFL PALMFL
       1075        WRITE-VARS KINETIC
       1076
       1077    CALCULATOR DEXTDEG
       1078        IN-UNITS SI SHORT-LENGTH=mm
       1079    F      REAL VOLFLOW, GLUFLOW, TNH3FLOW, LCFAFLOW, KINETIC, L, N, M, O
       1080    F      REAL A, NH3, NH4, P
       1081    F      REAL E, K, T, T0, R, S, Q, PH, PCONT, Z
       1082        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
       1083            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1084        DEFINE GLUFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1085            COMPONENT=DEXTROSE UOM="kg/hr"
       1086        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1087            COMPONENT=OLEICACI UOM="kg/hr"
       1088        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1089            COMPONENT=LINOLEIC UOM="kg/hr"
       1090        DEFINE PALMFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1091            COMPONENT=PALM UOM="kg/hr"
       1092        DEFINE NH3 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1093            COMPONENT=NH3 UOM="kg/hr"
       1094        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1095            COMPONENT=NH4+ UOM="kg/hr"
       1096        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1097            COMPONENT=H+ UOM="kg/hr"
       1098        DEFINE T BLOCK-VAR BLOCK=B1 VARIABLE=TEMP SENTENCE=PARAM  &
       1099            UOM="C"
       1100        DEFINE KINETIC REACT-VAR REACTION=ACIDOGEN VARIABLE=PRE-EXP  &
       1101            SENTENCE=RATE-CON ID1=1
       1102    F      A = .00000001
       1103    F      C_TNH3 = NH3 + NH4
       1104
       1105    F      C_VOL = VOLFLOW
       1106    F      IF (C_VOL .EQ. 0.) THEN
       1107    F       C_VOL = C_VOL + A
       1108    F      ENDIF
       1109
       1110    F      C_LCFA = LCFAFLOW + LINOFL + PALMFL
       1111    F      IF (C_LCFA .EQ. 0.) THEN
       1112    F       C_LCFA = C_LCFA + A
       1113    F      ENDIF
       1114
       1115    F      IF (C_TNH3 .EQ. 0.) THEN
       1116    F       C_TNH3 = C_TNH3 + A
       1117    F      ENDIF
       1118
       1119    F      C_GLU = GLUFLOW
       1120    F      IF (C_GLU .EQ. 0.) THEN
       1121    F       C_GLU = C_GLU + A
       1122    F      ENDIF
       1123
       1124    F      TK = T + 273.15
       1125    F      T0 = 55. + 273.15
       1126
       1127    F      C_PCONT = PCONT
       1128    F      IF (C_PCONT .EQ. 0.) THEN
       1129    F       C_PCONT = 0.0000001
       1130    F      ENDIF
       1131
       1132    F      PH = - ALOG10((C_PCONT)/(C_VOL))
       1133    F      PH = 6.5
       1134    F      IF ( PH .LT. 5.5) THEN
       1135    F       S = (( PH - 5.5 ) / (5.5 - 4. ) )
       1136    F       IF (S .LT. 0.) THEN
       1137    F        S = -S
       1138    F       ENDIF
       1139    F       R = ((-3.)*(S**2.))
       1140    F       Q = (2.7182818284**(R))
       1141    F      ELSE
       1142    F       Q = 1.
       1143    F      ENDIF
       1144
       1145    F      Z = 70. * EXP(-(-35616.457 / 8.314) * (1. / TK - 1. / T0))
       1146    F      L = ( 1. / ( 3600. * 24. ) ) * Z
       1147    F      P = 0.5 + 0.025 * ( TK - T0 )
       1148    F      N = 5.1 * ( 1. / ( 1. + P / ( C_GLU / C_VOL ) ) )
       1149    F      M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )
       1150    F      O = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )
       1151    F      K = L * N * M * O * Q
       1152    F      KINETIC = K
       1153        READ-VARS VOLFLOW GLUFLOW LCFAFLOW NH3 NH4 PCONT T LINOFL  &
       1154            PALMFL
       1155        WRITE-VARS KINETIC
       1156
       1157    CALCULATOR GLYCDEG
       1158        IN-UNITS SI SHORT-LENGTH=mm
       1159    F      REAL VOLFLOW, GTOFLOW, TNH3FLOW, LCFAFLOW, KINETIC, L, N, M, O
       1160    F      REAL A, NH3, NH4
       1161    F      REAL PH, Q, PCONT, R, S
       1162        DEFINE VOLFLOW STREAM-VAR STREAM=LIQUID SUBSTREAM=MIXED  &
       1163            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1164        DEFINE GTOFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1165            COMPONENT=GLYCEROL UOM="kg/hr"
       1166        DEFINE NH3 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1167            COMPONENT=NH3 UOM="kg/hr"
       1168        DEFINE PCONT MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1169            COMPONENT=H+ UOM="kg/hr"
       1170        DEFINE NH4 MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1171            COMPONENT=NH4+ UOM="kg/hr"
       1172        DEFINE LCFAFLOW MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
       1173            COMPONENT=OLEICACI UOM="kg/hr"
       1174        DEFINE LINOFL MASS-FLOW STREAM=LIQUID SUBSTREAM=MIXED  &
