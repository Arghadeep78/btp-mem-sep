        907    F      A = 0.0000001
        908    F      AA1 = ARG + HIS + LYS + TYR + TRYP + PHE + CYS + MET + THR + SER
        909    F      AA2 = LEU + ISO + VAL + GLU + ASP + GLY + ALA + PRO
        910    F      AA = AA1 + AA2
        911    F      IF (AA .EQ. 0.) THEN
        912    F       AA = AA + A
        913    F      ENDIF
        914    F      C_VOL = VOLFLOW
        915    F      IF (C_VOL .EQ. 0.) THEN
        916    F       C_VOL = C_VOL + A
        917    F      ENDIF
        918    F      C_PCONT = PCONT
        919    F      IF (C_PCONT .EQ. 0.) THEN
        920    F       C_PCONT = 0.0000001
        921    F      ENDIF
        922    F      PH = - ALOG10((C_PCONT) / (C_VOL))
        923    F      S = 0.0
        924    F      IF (PH .LT. 5.5) THEN
        925    F       S = ((PH - 5.5) / (5.5 - 4.0))
        926    F      ENDIF
        927    F      IF (S .LT. 0.0) THEN
        928    F       S = -S
        929    F      ENDIF
        930    F      R = ((-3.0) * (S**2.0))
        931    F      Q = (2.7182818284**(R))
        932    F      N = (1.0 / (1.0 + 0.3 / (AA / C_VOL)))
        933    F      TK = T + 273.15
        934    F      T0 = 55.0 + 273.15
        935    F      Z = 70.0 * EXP(-(-14143.72619 / 8.314) *
        936    F    &     (1.0 / TK - 1.0 / T0))
        937    F      L = (1.0 / (3600.0 * 24.0)) * Z
        938    F      K = L * N * Q
        939    F      KIN1 = K
        940    F      KIN2 = K
        941    F      KIN3 = K
        942    F      KIN4 = K
        943    F      KIN5 = K
        944    F      KIN6 = K
        945    F      KIN7 = K
        946    F      KIN8 = K
        947    F      KIN9 = K
        948    F      KIN10 = K
        949    F      KIN11 = K
        950    F      KIN12 = K
        951    F      KIN13 = K
        952    F      KIN14 = K
        953    F      KIN15 = K
        954    F      KIN16 = K
        955    F      KIN17 = K
        956    F      KIN18 = K
        957    F      KIN19 = K
        958    F      KIN20 = K
        959    F      KIN21 = K
        960    F      KIN22 = K
        961    F      KIN23 = K
