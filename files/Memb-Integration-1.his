        783            PHASE=V MAX-NSTEP=50000 INT-TOL=0.0001 CATWT=24.668  &
        784            CAT-PRESENT=YES CAT-RHO=1500. <kg/cum>
        785        T-SPEC 0.0 790.
        786        COOLANT TOL=0.001
        787        INTEG-PARAMS NONNEG=NO
        788        BLOCK-OPTION FREE-WATER=NO
        789        REACTIONS RXN-IDS=R-2 R-1
        790
        791    BLOCK COMP1 COMPR
        792        PARAM TYPE=ISENTROPIC PRES=3.18 SEFF=0.75 SB-MAXIT=30  &
        793            SB-TOL=0.0001
        794
        795    BLOCK COMP2 COMPR
        796        PARAM TYPE=ISENTROPIC PRES=10. SEFF=0.75 SB-MAXIT=30  &
        797            SB-TOL=0.0001
        798
        799    BLOCK MEMB1 ACMMODEL
        800        IN-UNITS ENG SHORT-LENGTH=in
        801        DMO-PARAMS DEFAULT
        802        DMO-PARAMS SIM
        803        DMO-PARAMS PARAM
        804        DMO-PARAMS RECON
        805        DMO-PARAMS OPTIM
        806        LSSQP-PARAMS DEFAULT
        807        LSSQP-PARAMS SIM
        808        LSSQP-PARAMS PARAM
        809        LSSQP-PARAMS RECON
        810        LSSQP-PARAMS OPTIM
        811        NSOLVE-PARAM DEFAULT
        812        NSOLVE-PARAM SIM
        813        NSOLVE-PARAM PARAM
        814        PARAMETERS USER-BYPASS=YES MODEL="Zeo_real"
        815        STRINGPARAM NAME="SECOND_DERIV_METHOD" VALUE="NUMERIC"
        816        STRINGPARAM NAME="SM_STATUS" VALUE="Converged"
        817        VARIABLES NAME="FEED.T" VALUE=30.0000000000001
        818        VARIABLES NAME="PERMEATE.T" VALUE=30.0000000000001
        819        VARIABLES NAME="PERMEATE.P" SPEC=CONST
        820        VARIABLES NAME="PERMEATE.V" SPEC=CONST VALUE=50
        821        VARIABLES NAME="RETENTATE.T" VALUE=30.0000000000001
        822        CONNECT STREAM=GAS2C PORT="FEED"
        823        CONNECT STREAM=PER PORT="PERMEATE"
        824        CONNECT STREAM=RET PORT="RETENTATE"
        825
        826    EO-CONV-OPTI
        827
        828    ENDHIERARCHY METH
