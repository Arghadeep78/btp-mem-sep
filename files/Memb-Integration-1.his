       1135    CALCULATOR GLYCDEG
       1136        IN-UNITS SI SHORT-LENGTH=mm
       1137    F      REAL VOLFLOW, GTOFLOW, TNH3FLOW, LCFAFLOW, KINETIC, L, N, M, O
       1138    F      REAL A, NH3, NH4
       1139    F      REAL PH, Q, PCONT, R, S
       1140        DEFINE VOLFLOW STREAM-VAR STREAM=5 SUBSTREAM=MIXED  &
       1141            VARIABLE=STDVOL-FLOW UOM="cum/hr"
       1142        DEFINE GTOFLOW MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1143            COMPONENT=GLYCEROL UOM="kg/hr"
       1144        DEFINE NH3 MASS-FLOW STREAM=5 SUBSTREAM=MIXED COMPONENT=NH3  &
       1145            UOM="kg/hr"
       1146        DEFINE PCONT MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1147            COMPONENT=H+ UOM="kg/hr"
       1148        DEFINE NH4 MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1149            COMPONENT=NH4+ UOM="kg/hr"
       1150        DEFINE LCFAFLOW MASS-FLOW STREAM=5 SUBSTREAM=MIXED  &
       1151            COMPONENT=OLEICACI UOM="kg/hr"
       1152        DEFINE KINETIIC REACT-VAR REACTION=ACIDOGEN VARIABLE=PRE-EXP  &
       1153            SENTENCE=RATE-CON ID1=2
       1154    F      A = .00000001
       1155    F      C_TNH3 = NH3 + NH4
       1156
       1157    F      C_VOL = VOLFLOW
       1158    F      IF (C_VOL .EQ. 0.) THEN
       1159    F       C_VOL = C_VOL + A
       1160    F      ENDIF
       1161
       1162    F      C_LCFA = LCFAFLOW
       1163    F      IF (C_LCFA .EQ. 0.) THEN
       1164    F       C_LCFA = C_LCFA + A
       1165    F      ENDIF
       1166
       1167    F      IF (C_TNH3 .EQ. 0.) THEN
       1168    F       C_TNH3 = C_TNH3 + A
       1169    F      ENDIF
       1170
       1171    F      C_GTO = GTOFLOW
       1172    F      IF (C_GTO .EQ. 0.) THEN
       1173    F       C_GTO = C_GTO + A
       1174    F      ENDIF
       1175
       1176    F      C_PCONT = PCONT
       1177    F      IF (C_PCONT .EQ. 0.) THEN
       1178    F       C_PCONT = 0.0000001
       1179    F      ENDIF
       1180
       1181    F      L = ( 1. / ( 3600. * 24. ) )
