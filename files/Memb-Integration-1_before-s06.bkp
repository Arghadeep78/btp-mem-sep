"RATE-CON" FVN-ID1 = 22 \ \ DEFINE FVN = KIN23 FVN-VARTYPE = "REACT-VAR" 
FVN-BLOCK = AMINOACI FVN-VARIABLE = "PRE-EXP" FVN-SENTENCE = "RATE-CON" 
FVN-ID1 = 23 \ \ FORTRAN FORTRAN-EXEC = ( "       A = 0.0000001" 
"       AA1 = ARG + LYS + TYR + TRYP + PHE + CYS + MET + THR + SER" 
"       AA2 = LEU + ISO + VAL + GLU + ASP + GLY + ALA + PRO" 
"       AA = AA1 + AA2" "       IF (AA .EQ. 0.) THEN" "        AA = AA + A" 
"       ENDIF" "       C_VOL = VOLFLOW" "       IF (C_VOL .EQ. 0.) THEN" 
"        C_VOL = C_VOL + A" "       ENDIF" "       C_PCONT = PCONT" 
"       IF (C_PCONT .EQ. 0.) THEN" "        C_PCONT = 0.0000001" "       ENDIF" 
"       PH = - ALOG10((C_PCONT) / (C_VOL))" "       S = 0.0" 
"       IF (PH .LT. 5.5) THEN" "        S = ((PH - 5.5) / (5.5 - 4.0))" 
"       ENDIF" "       IF (S .LT. 0.0) THEN" "        S = -S" "       ENDIF" 
"       R = ((-3.0) * (S**2.0))" "       Q = (2.7182818284**(R))" 
"       N = (1.0 / (1.0 + 0.3 / (AA / C_VOL)))" "       TK = T + 273.15" 
"       T0 = 55.0 + 273.15" "       Z = 70.0 * EXP(-(-14143.72619 / 8.314) * " 
"     &     (1.0 / TK - 1.0 / T0))" "       L = (1.0 / (3600.0 * 24.0)) * Z" 
"       K = L * N * Q" "       KIN1 = K" "       KIN2 = K" "       KIN3 = K" 
"       KIN4 = K" "       KIN5 = K" "       KIN6 = K" "       KIN7 = K" 
"       KIN8 = K" "       KIN9 = K" "       KIN10 = K" "       KIN11 = K" 
"       KIN12 = K" "       KIN13 = K" "       KIN14 = K" "       KIN15 = K" 
"       KIN16 = K" "       KIN17 = K" "       KIN18 = K" "       KIN19 = K" 
"       KIN20 = K" "       KIN21 = K" "       KIN22 = K" "       KIN23 = K" ) 
