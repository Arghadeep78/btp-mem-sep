"       REAL PH, Q, PCONT, NH3, NH4" 
"       REAL E, K, T, T0, U, H2, I, H2I, Z" ) \ \ DEFINE FVN = VOLFLOW 
FVN-VARTYPE = "STREAM-VAR" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-VARIABLE = 
"STDVOL-FLOW" FVN-UOM = "cum/hr" \ \ DEFINE FVN = HACFLOW FVN-VARTYPE = 
"MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = "ACETI-AC" FVN-UOM
 = "kg/hr" \ \ DEFINE FVN = TNH3FLOW FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
FVN-SUBS = MIXED FVN-COMPONEN = NH3 FVN-UOM = "kg/hr" \ \ DEFINE FVN = LCFAFLOW FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED 
FVN-COMPONEN = OLEICACI FVN-UOM = "kg/hr" \ \ DEFINE FVN = LINOFL FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
FVN-SUBS = MIXED FVN-COMPONEN = LINOLEIC FVN-UOM = "kg/hr" \ \ DEFINE FVN = PALMFL 
FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = PALM 
FVN-UOM = "kg/hr" \ \ DEFINE FVN = PCONT FVN-VARTYPE
 = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = "H+" FVN-UOM = 
"kg/hr" \ \ DEFINE FVN = NH4 FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
FVN-SUBS = MIXED FVN-COMPONEN = "NH4+" FVN-UOM = "kg/hr" \ \ DEFINE FVN = T 
FVN-VARTYPE = "BLOCK-VAR" FVN-BLOCK = B1 FVN-VARIABLE = TEMP FVN-SENTENCE = 
PARAM FVN-UOM = C \ \ DEFINE FVN = H2 FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = HYDROGEN FVN-UOM = "kg/hr" \ \ DEFINE FVN
 = KINETIC FVN-VARTYPE = "REACT-VAR" FVN-BLOCK = ACETOGEN FVN-VARIABLE = 
"PRE-EXP" FVN-SENTENCE = "RATE-CON" FVN-ID1 = 4 \ \ DEFINE FVN = VALEFLOW 
FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = 
"ISOVA-01" FVN-UOM = "kg/hr" \ \ FORTRAN FORTRAN-EXEC = ( "      A = .00000001" 
"" "      CHAC = HACFLOW" "      IF (CHAC .EQ. 0.) THEN" "        CHAC = A" 
"      ENDIF" "" "      CLCFA = LCFAFLOW + LINOFL + PALMFL" "      IF (CLCFA .EQ. 0.) THEN" 
"        CLCFA = A" "      ENDIF" "" "      CVOL = VOLFLOW" 
"      IF (CVOL .EQ. 0.) THEN" "        CVOL = A" "      ENDIF" "" 
"      CTNH3 = TNH3FLOW + NH4" "      IF (CTNH3 .EQ. 0.) THEN" "        CTNH3 = A" 
"      ENDIF" "" "      CPCONT = PCONT" "      IF (CPCONT .EQ. 0.) THEN" 
"        CPCONT = 0.0000001" "      ENDIF" "" "      CVALE = VALEFLOW" 
"      IF (CVALE .EQ. 0.) THEN" "        CVALE = A" "      ENDIF" "" 
"      TK = T + 273.15" "      T0 = 55. + 273.15" "" 
"      H2I = 0.00003 + 0.000001 * ( TK - T0 )" 
"      I = 1. / ( 1. + ( H2 / CVOL ) / H2I )" "      " 
"      Z1 = -17043.8653 / 8.314" "      Z2 = 1. / TK - 1. / T0" 
"      Z = 30. * EXP(-(Z1) * Z2)" "      " 
"      L = (1. / ( 3600. * 24. ) ) * Z" "      U = .175 + .01 * ( TK - T0 )" 
"      N = 1. / ( 1. + U / ( CVALE / CVOL ) )" 
"      M = 1. / ( 1. + .05 / ( CTNH3 / CVOL ) )" 
"      O = 1. / ( 1. + ( CHAC / CVOL ) / .4 )" 
"      P = 1. / ( 1. + ( CLCFA / CVOL ) / 5. )" "" 
"      PH = - ALOG10((CPCONT) / CVOL)" "      PH = 6.5" 
"      IF ( PH .LT. 5.5) THEN" "        S = (( PH - 5.5 ) / (5.5 - 4. ) )" 
"        IF (S .LT. 0.) THEN" "          S = -S" "        ENDIF" 
"        R = (-3.) * (S**2.)" "        Q = 2.7182818284**(R)" "      ELSE " 
"        Q = 1." "      ENDIF" "" "      K = L * N * M * O * P * Q * I " 
"      KINETIC = K" ) \ \ "READ-VARS" READ-VAR = ( VOLFLOW HACFLOW TNH3FLOW 
LCFAFLOW PCONT NH4 T H2 VALEFLOW LINOFL PALMFL ) \ \ "WRITE-VARS" WRITE-VAR = ( KINETIC ) 
