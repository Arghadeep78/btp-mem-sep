) \ \ DEFINE FVN = VOLFLOW FVN-VARTYPE = "STREAM-VAR" FVN-STREAM = LIQUID FVN-SUBS
 = MIXED FVN-VARIABLE = "STDVOL-FLOW" FVN-UOM = "cum/hr" \ \ DEFINE FVN = 
