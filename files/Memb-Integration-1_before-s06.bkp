"       C_PCONT = PCONT" "       IF (C_PCONT .EQ. 0.) THEN" 
"        C_PCONT = 0.0000001" "       ENDIF" "       C_H2 = H2FLOW" 
"       IF (C_H2 .EQ. 0.) THEN" "        C_H2 = A" "       ENDIF" 
"       TK = T + 273.15" "       T0 = 55. + 273.15" 
"       Z = 16. * EXP(-(-29136.6801 / 8.314) * (1. / TK - 1. / T0))" 
"       L = (1. / ( 3600. * 24. ) ) * Z" 
"       X = (1. / ( 3600. * 24. ) ) * 35." "       V = .12 + .0075 * (TK - T0)" 
"       N = ( 1. / ( 1. + V / ( C_HAC / C_VOL ) ) )" 
"       U = 0.00005 + 0.00000215 * (TK - T0)" 
"       S = ( 1. / (1. + U / (C_H2 / C_VOL)))" 
"       M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )" 
