FVN-COMPONEN = DEXTROSE FVN-UOM = "kg/hr" \ \ DEFINE FVN = LCFAFLOW FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED 
FVN-COMPONEN = OLEICACI FVN-UOM = "kg/hr" \ \ DEFINE FVN = LINOFL FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
