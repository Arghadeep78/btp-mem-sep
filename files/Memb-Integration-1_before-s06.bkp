FVN-VARIABLE = TEMP FVN-SENTENCE = PARAM FVN-UOM = C \ \ DEFINE FVN = KINETIC 
FVN-VARTYPE = "REACT-VAR" FVN-BLOCK = ACIDOGEN FVN-VARIABLE = "PRE-EXP" 
FVN-SENTENCE = "RATE-CON" FVN-ID1 = 1 \ \ FORTRAN FORTRAN-EXEC = ( 
"       A = .00000001" "       C_TNH3 = NH3 + NH4" "" "       C_VOL = VOLFLOW" 
"       IF (C_VOL .EQ. 0.) THEN" "        C_VOL = C_VOL + A" "       ENDIF" "" 
"       C_LCFA = LCFAFLOW + LINOFL + PALMFL" "       IF (C_LCFA .EQ. 0.) THEN" 
"        C_LCFA = C_LCFA + A" "       ENDIF" "" 
"       IF (C_TNH3 .EQ. 0.) THEN" "        C_TNH3 = C_TNH3 + A" "       ENDIF" 
"" "       C_GLU = GLUFLOW" "       IF (C_GLU .EQ. 0.) THEN" 
"        C_GLU = C_GLU + A" "       ENDIF" "" "       TK = T + 273.15" 
"       T0 = 55. + 273.15" "" "       C_PCONT = PCONT" 
"       IF (C_PCONT .EQ. 0.) THEN" "        C_PCONT = 0.0000001" "       ENDIF" 
"" "       PH = - ALOG10((C_PCONT)/(C_VOL))" "       PH = 6.5" 
"       IF ( PH .LT. 5.5) THEN" "        S = (( PH - 5.5 ) / (5.5 - 4. ) )" 
"        IF (S .LT. 0.) THEN" "         S = -S" "        ENDIF" 
"        R = ((-3.)*(S**2.))" "        Q = (2.7182818284**(R))" "       ELSE " 
"        Q = 1." "       ENDIF" "" 
"       Z = 70. * EXP(-(-35616.457 / 8.314) * (1. / TK - 1. / T0))" 
"       L = ( 1. / ( 3600. * 24. ) ) * Z" 
"       P = 0.5 + 0.025 * ( TK - T0 )" 
"       N = 5.1 * ( 1. / ( 1. + P / ( C_GLU / C_VOL ) ) )" 
"       M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )" 
"       O = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) ) " 
"       K = L * N * M * O * Q " "       KINETIC = K" ) \ \ "READ-VARS" 
READ-VAR = ( VOLFLOW GLUFLOW LCFAFLOW NH3 NH4 PCONT T LINOFL PALMFL ) \ \ "WRITE-VARS" 
WRITE-VAR = ( KINETIC ) \ ? CALCULATOR GLYCDEG ? ; "SI_MOLE" ; \ DECLARE FORTRAN-DEC = ( 
