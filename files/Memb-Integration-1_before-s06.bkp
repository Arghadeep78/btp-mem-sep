\ DEFINE FVN = KIN19 FVN-VARTYPE = "REACT-VAR" FVN-BLOCK = AMINOACI 
FVN-VARIABLE = "PRE-EXP" FVN-SENTENCE = "RATE-CON" FVN-ID1 = 19 \ \ DEFINE 
FVN = KIN20 FVN-VARTYPE = "REACT-VAR" FVN-BLOCK = AMINOACI FVN-VARIABLE = 
"PRE-EXP" FVN-SENTENCE = "RATE-CON" FVN-ID1 = 20 \ \ DEFINE FVN = KIN21 
