FVN-VARTYPE = "STREAM-VAR" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-VARIABLE = 
"STDVOL-FLOW" FVN-UOM = "cum/hr" \ \ DEFINE FVN = HACFLOW FVN-VARTYPE = 
"MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = "ACETI-AC" FVN-UOM
 = "kg/hr" \ \ DEFINE FVN = NH3 FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
FVN-SUBS = MIXED FVN-COMPONEN = NH3 FVN-UOM = "kg/hr" \ \ DEFINE FVN = LCFAFLOW FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED 
FVN-COMPONEN = OLEICACI FVN-UOM = "kg/hr" \ \ DEFINE FVN = LINOFL FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
FVN-SUBS = MIXED FVN-COMPONEN = LINOLEIC FVN-UOM = "kg/hr" \ \ DEFINE FVN = PALMFL 
FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = PALM 
FVN-UOM = "kg/hr" \ \ DEFINE FVN = PCONT FVN-VARTYPE
 = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = "H+" FVN-UOM = 
"kg/hr" \ \ DEFINE FVN = NH4 FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID 
FVN-SUBS = MIXED FVN-COMPONEN = "NH4+" FVN-UOM = "kg/hr" \ \ DEFINE FVN = T 
FVN-VARTYPE = "BLOCK-VAR" FVN-BLOCK = B1 FVN-VARIABLE = TEMP FVN-SENTENCE = 
PARAM FVN-UOM = C \ \ DEFINE FVN = H2 FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = HYDROGEN FVN-UOM = "kg/hr" \ \ DEFINE FVN
 = BUTYFLOW FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED 
FVN-COMPONEN = "ISOBU-01" FVN-UOM = "kg/hr" \ \ DEFINE FVN = KINETIC FVN-VARTYPE = "REACT-VAR" 
FVN-BLOCK = ACETOGEN FVN-VARIABLE = "PRE-EXP" FVN-SENTENCE = "RATE-CON" 
FVN-ID1 = 3 \ \ FORTRAN FORTRAN-EXEC = ( "       A = .00000001" 
"       C_TNH3 = NH3 + NH4" "       " "       C_HAC = HACFLOW" 
"       IF (C_HAC .EQ. 0.) THEN" "        C_HAC = C_HAC + A" "       ENDIF" 
"       " "       C_LCFA = LCFAFLOW + LINOFL + PALMFL" "       IF (C_LCFA .EQ. 0.) THEN" 
"        C_LCFA = C_LCFA + A" "       ENDIF" "       " "       C_VOL = VOLFLOW" 
"       IF (C_VOL .EQ. 0.) THEN" "        C_VOL = C_VOL + A" "       ENDIF" 
"       " "       IF (C_TNH3 .EQ. 0.) THEN" "        C_TNH3 = C_TNH3 + A" 
"       ENDIF" "       " "       C_PCONT = PCONT" 
"       IF (C_PCONT .EQ. 0.) THEN" "        C_PCONT = 0.0000001" "       ENDIF" 
"       " "       C_BUTY = BUTYFLOW" "       IF (C_BUTY .EQ. 0.) THEN" 
"        C_BUTY = A" "       ENDIF" "       " "       TK = T + 273.15" 
"       T0 = 55. + 273.15" "       H2I = 0.00003 + 0.000001 * ( TK - T0 )" 
"       I = ( 1. / ( 1. + ( H2 / C_VOL ) / H2I ) )" 
"       Z = 30. * EXP(-(-17043.8653 / 8.314) * (1. / TK - 1. / T0))" 
"       L = (1. / ( 3600. * 24. ) ) * Z" "       U = .176 + .01 * ( TK - T0 )" 
"       N = ( 1. / ( 1. + U / ( C_BUTY / C_VOL ) ) )" 
"       M = ( 1. / ( 1. + .05 / ( C_TNH3 / C_VOL ) ) )" 
"       O = ( 1. / ( 1. + ( C_HAC / C_VOL ) / .72 ) )" 
"       P = ( 1. / ( 1. + ( C_LCFA / C_VOL ) / 5. ) )" "       " 
"       PH = - ALOG10((C_PCONT)/(C_VOL))" "       PH = 6.5" 
"       IF ( PH .LT. 5.5) THEN" "        S = (( PH - 5.5 ) / (5.5 - 4. ) )" 
"        IF (S .LT. 0.) THEN" "         S = -S" "        ENDIF" 
"        R = ((-3.) * (S**2.))" "        Q = (2.7182818284**(R))" 
"       ELSE " "        Q = 1." "       ENDIF" "       " 
"       K = L * N * M * O * P * Q * I " "       KINETIC = K" ) \ \ "READ-VARS" 
READ-VAR = ( VOLFLOW HACFLOW NH3 LCFAFLOW PCONT NH4 T H2 BUTYFLOW LINOFL PALMFL ) \ \ 
"WRITE-VARS" WRITE-VAR = ( KINETIC ) \ ? CALCULATOR DEXTDEG ? ; "SI_MOLE" ; \ DECLARE 
FORTRAN-DEC = ( 
