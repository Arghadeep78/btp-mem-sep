FVN-VARTYPE = "MASS-FLOW" FVN-STREAM = LIQUID FVN-SUBS = MIXED FVN-COMPONEN = PALM 
FVN-UOM = "kg/hr" \ \ DEFINE FVN = NH3 FVN-VARTYPE = "MASS-FLOW" 
